{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build",
    "variables": {
      "NIXPACKS_NODE_VERSION": "20"
    }
  },
  "deploy": {
    "startCommand": "node dist/main",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
