# =====================================================================
# Custom Boxify API — environment template
# Copy to `.env` and fill every value. Startup fails fast on invalid/missing vars.
# NEVER commit real credentials.
# =====================================================================

# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=custom-boxify-api
LOG_LEVEL=info
PAGE_MAX_LIMIT=100

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE_NAME=boxify
MONGODB_POOL_SIZE=10
MONGODB_QUERY_TIMEOUT_MS=5000

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=custom-boxify-api
JWT_AUDIENCE=custom-boxify-admin

# --- CORS / app URLs ---
ADMIN_APP_URL=http://localhost:3001
CLIENT_APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Cookies ---
COOKIE_ACCESS_NAME=boxify_access
COOKIE_REFRESH_NAME=boxify_refresh
# Empty = host-only cookies (default). Set for cross-subdomain cookie sharing.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Auth security ---
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MS=900000
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_PASSWORD_MIN_LENGTH=12

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
# From an R2 S3 API token. This is not the R2 account ID.
R2_ACCESS_KEY_ID=
# Secret paired with R2_ACCESS_KEY_ID when the API token is created.
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=boxify-media
R2_PUBLIC_BUCKET_NAME=
R2_ENDPOINT=
R2_REGION=auto
R2_UPLOAD_EXPIRES_IN=3600
# Fail storage checks before the admin proxy's 15-second timeout.
R2_CONNECTION_TIMEOUT_MS=5000
R2_REQUEST_TIMEOUT_MS=10000
# Public CDN/custom domain for media URLs, e.g. https://media.example.com
R2_PUBLIC_BASE_URL=

# --- Media ---
MEDIA_MAX_UPLOAD_SIZE_BYTES=10485760
MEDIA_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
MEDIA_ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif
MEDIA_MAX_VIDEO_UPLOAD_SIZE_BYTES=104857600
MEDIA_ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
MEDIA_ALLOWED_VIDEO_EXTENSIONS=mp4,webm,mov
MEDIA_MAX_DOCUMENT_UPLOAD_SIZE_BYTES=26214400
MEDIA_ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
MEDIA_ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx

# --- Bulk import ---
BULK_IMPORT_MAX_FILE_SIZE_BYTES=20971520
BULK_IMPORT_MAX_ROWS=20000
BULK_IMPORT_BATCH_SIZE=500
BULK_IMPORT_CONCURRENCY=2
BULK_IMPORT_ZIP_MAX_SIZE_BYTES=52428800
BULK_IMPORT_ZIP_MAX_FILES=500
BULK_IMPORT_ZIP_MAX_RATIO=100

# --- Cache ---
CACHE_DEFAULT_TTL_MS=300000
PRODUCT_LIST_CACHE_TTL_MS=300000
PRODUCT_DETAIL_CACHE_TTL_MS=600000
CATEGORY_CACHE_TTL_MS=600000
FILTER_CACHE_TTL_MS=600000

# --- Rate limit (global) ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# --- Jobs ---
JOBS_IMAGE_CONCURRENCY=2
JOBS_CLEANUP_CONCURRENCY=1
JOBS_NOTIFICATION_CONCURRENCY=1
IMAGE_VARIANT_SIZES=thumbnail:240,small:480,medium:960,large:1600

# --- Seeding (idempotent) ---
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_NAME=Super Admin

# --- Swagger ---
SWAGGER_ENABLED=true
# Optional basic-auth guard on the Swagger UI in production:
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# --- Email (optional; used by forgot/invite flows. Logs to console when unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Boxify <no-reply@example.com>
